# =============================================================
# Palimpsest configuration
# Copy this file to `.env` and adjust the values to your setup.
# All values below are placeholders / defaults — no real secrets.
# =============================================================

# ---- Services -------------------------------------------------
# Port for the FastAPI REST service.
REST_PORT=8090
# Port for the dashboard service.
DASHBOARD_PORT=8010

# ---- Storage ---------------------------------------------------
# Path to the embedded TriviumDB database (vector + graph + document).
DB_PATH=data/mh_memory.db

# ---- Security --------------------------------------------------
# Optional REST auth. Empty (the default) = auth disabled, localhost direct
# access. When set, every route except "/" requires an Authorization:
# Bearer <key> or X-API-Key: <key> header — for LAN / trusted-network
# deployments. Public deployments must still terminate TLS in a reverse proxy.
PALIMPSEST_API_KEY=

# ---- LLM backend ------------------------------------------------
# Which LLM backend to use: "deepseek" or "ollama".
LLM_BACKEND=deepseek

# DeepSeek (used when LLM_BACKEND=deepseek)
DEEPSEEK_API_KEY=YOUR_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama (used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=deepseek-r1:7b

# ---- Embeddings --------------------------------------------------
# Embedding backend: "ollama" (local, private) or "openai"
# (OpenAI-compatible cloud such as Voyage / SiliconFlow / OpenAI).
# Leave empty to auto-detect: valid EMBEDDING_API_KEY → openai, otherwise → ollama.
# Explicitly set "ollama" or "openai" to force a specific provider.
# NOTE: switching provider changes the vector space — you must rebuild
# the knowledge-base index afterwards (scripts/build_kb_index.py).
EMBEDDING_PROVIDER=

# Local Ollama embedding (used when EMBEDDING_PROVIDER=ollama)
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIM=1024
# Ollama native embedding API root (used for /api/embeddings), decoupled from the LLM's OLLAMA_BASE_URL (/v1 OpenAI-compatible)
OLLAMA_EMBEDDING_BASE_URL=http://localhost:11434

# Cloud embedding (used when EMBEDDING_PROVIDER=openai)
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# ---- Retrieval weights -------------------------------------------
# Monthly memory decay applied at ranking: score = cosine * importance
# * MEMORY_DECAY_FACTOR^(days_since_created/30). Set to 1.0 to disable.
MEMORY_DECAY_FACTOR=0.95
# Rerank mode: "soft" = semantic score as the main line plus ε-level metadata
# nudges (default); "hard" = legacy multiplicative weighting (fallback).
MEMORY_RERANK_MODE=soft
# ε for "soft" mode: 15%-40% of the cosine gap, tie-break only.
SOFT_RERANK_EPS=0.02
# Additive soft domain boost applied to the semantic score for same-domain
# candidates when `domain_boost` is set (mem_search / mem_hybrid_search).
DOMAIN_BOOST_EPS=0.10
# ε multiplier for kb_chunk (knowledge blocks never decay) under "soft" mode.
KB_SOFT_RERANK_MULT=1.5
# Score multiplier for rule-domain knowledge slices.
RULE_RETRIEVAL_WEIGHT=1.3
# Extra weight for domain-biased retrieval.
DOMAIN_BIAS_WEIGHT=1.15

# ---- Graph expansion -----------------------------------------------
# Max strongest edges diffused per node during neighbor expansion
# (prevents high-degree nodes from flooding the result).
EXPAND_MAX_EDGES_PER_NODE=20
# Weak-edge pruning threshold during expansion (0.0 disables).
EXPAND_MIN_EDGE_WEIGHT=0.0

# ---- Hybrid retrieval (RRF) -----------------------------------------
# Reciprocal Rank Fusion constant k for FTS5 + semantic fusion
# (both sides count even if only one hits).
RRF_K=60.0
# RRF weights per side: semantic / exact (FTS).
RRF_SEM_WEIGHT=1.0
RRF_FTS_WEIGHT=0.1
# Graph expansion depth for the semantic ordering: 0 = pure semantic ranking
# (default); 1 = graph neighbors join the ordering (one-flag fallback).
RETRIEVAL_EXPAND_DEPTH=0

# ---- Limits --------------------------------------------------------
# Max characters of a single memory content; longer writes are rejected.
MEM_INGEST_MAX_LENGTH=50000

# ---- Knowledge base ----------------------------------------------
# Root directory of the knowledge base (Obsidian .md files) to index.
# Leave empty to fall back to the default project-relative location.
KNOWLEDGE_DIR=
