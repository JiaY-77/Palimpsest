# =============================================================
# Palimpsest configuration
# Copy this file to `.env` and adjust the values to your setup.
# All values below are placeholders / defaults — no real secrets.
# =============================================================

# ---- Services -------------------------------------------------
# Port for the FastAPI REST service.
REST_PORT=8090
# Port for the dashboard service.
DASHBOARD_PORT=8010

# ---- Storage ---------------------------------------------------
# Path to the embedded TriviumDB database (vector + graph + document).
DB_PATH=data/mh_memory.db

# ---- Security --------------------------------------------------
# Optional REST auth. Empty (the default) = auth disabled, localhost direct
# access. When set, every route except "/" requires an Authorization:
# Bearer <key> or X-API-Key: <key> header — for LAN / trusted-network
# deployments. Public deployments must still terminate TLS in a reverse proxy.
PALIMPSEST_API_KEY=

# ---- LLM backend ------------------------------------------------
# Which LLM backend to use: "deepseek" or "ollama".
LLM_BACKEND=deepseek

# DeepSeek (used when LLM_BACKEND=deepseek)
DEEPSEEK_API_KEY=YOUR_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Ollama (used when LLM_BACKEND=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=deepseek-r1:7b

# ---- Embeddings --------------------------------------------------
# Embedding backend: "ollama" (local, private) or "openai"
# (OpenAI-compatible cloud such as Voyage / SiliconFlow / OpenAI).
# Leave empty to auto-detect: valid EMBEDDING_API_KEY → openai, otherwise → ollama.
# Explicitly set "ollama" or "openai" to force a specific provider.
# NOTE: switching provider changes the vector space — you must rebuild
# the knowledge-base index afterwards (scripts/build_kb_index.py).
EMBEDDING_PROVIDER=

# Local Ollama embedding (used when EMBEDDING_PROVIDER=ollama)
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_DIM=1024
# Ollama native embedding API root (used for /api/embeddings), decoupled from the LLM's OLLAMA_BASE_URL (/v1 OpenAI-compatible)
OLLAMA_EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Cloud embedding (used when EMBEDDING_PROVIDER=openai)
EMBEDDING_API_KEY=YOUR_API_KEY
EMBEDDING_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIM=1024

# In-process local embedding (used when EMBEDDING_PROVIDER=local):
# runs a GGUF model via llama-cpp-python inside the process — no Ollama needed.
# Install the backend first: pip install "palimpsest[local-embed]".
# Non-empty = absolute path to a local GGUF file; skips download entirely.
EMBEDDING_MODEL_PATH=
# Repo used for auto-download (ModelScope is tried first under "auto").
EMBEDDING_MODEL_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
# File name used for auto-download (also the cache-dir file name).
EMBEDDING_MODEL_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
# Integrity check: sha256 of the downloaded file (mismatch -> file deleted, re-download).
EMBEDDING_MODEL_SHA256=06507c7b42688469c4e7298b0a1e16deff06caf291cf0a5b278c308249c3e439
# Expected byte size (used for progress and integrity check).
EMBEDDING_MODEL_SIZE=639150592
# Model cache directory; empty = <project root>/models.
EMBEDDING_MODELS_DIR=
# Download source: "auto" (ModelScope -> HuggingFace) / "modelscope" / "huggingface".
# Do NOT use hf-mirror.com — it 308-redirects this repo back to huggingface.co.
EMBEDDING_DOWNLOAD_SOURCE=auto
# Whether to auto-download when the model is missing (0 = fail with instructions).
EMBEDDING_AUTO_DOWNLOAD=1
# Output dimension of the local embedding model (Qwen3-Embedding-0.6B = 1024).
EMBEDDING_LOCAL_DIM=1024
# llama.cpp context length (measured baseline; do not raise without testing).
EMBEDDING_LOCAL_N_CTX=2048
# CPU thread count for llama.cpp; 0 = let llama.cpp decide.
EMBEDDING_LOCAL_N_THREADS=0

# ---- Retrieval weights -------------------------------------------
# Monthly memory decay applied at ranking: score = cosine * importance
# * MEMORY_DECAY_FACTOR^(days_since_created/30). Set to 1.0 to disable.
MEMORY_DECAY_FACTOR=0.95
# Rerank mode: "soft" = semantic score as the main line plus ε-level metadata
# nudges (default); "hard" = legacy multiplicative weighting (fallback).
MEMORY_RERANK_MODE=soft
# ε for "soft" mode: 15%-40% of the cosine gap, tie-break only.
SOFT_RERANK_EPS=0.02
# Memory confidence as an ε-level tie-break (0 = disabled, the default).
# Confidence is computed from observable evidence via Subjective Logic
# (see docs/CONFIDENCE.md). It is never a filter: measured filtering costs
# 4.81pp of recall. Best measured value: 0.05.
MEMORY_CONFIDENCE_EPS=0
# Map belief b to [-1, 1]: b == center -> 0, b >= center + span -> +1.
MEMORY_CONFIDENCE_CENTER=0.27
MEMORY_CONFIDENCE_SPAN=0.15
# Additive soft domain boost applied to the semantic score for same-domain
# candidates when `domain_boost` is set (mem_search / mem_hybrid_search).
DOMAIN_BOOST_EPS=0.10
# ε multiplier for kb_chunk (knowledge blocks never decay) under "soft" mode.
KB_SOFT_RERANK_MULT=1.5
# Extra weight for domain-biased retrieval.
DOMAIN_BIAS_WEIGHT=1.15
# Freshness weighting for mem_search (data-first, 0 = disabled = identical
# behavior). Applies score += WEIGHT * decay(node age) before ranking.
# Any non-zero value must be justified by eval/freshness_sweep.py output
# on a real query set — do not hand-pick a constant.
MEM_SEARCH_FRESHNESS_WEIGHT=0
# Decay time scale in days: half-life for "exp", zero-crossing for "linear".
MEM_SEARCH_FRESHNESS_SCALE_DAYS=30
# Decay form: "exp" (default) or "linear"; anything else falls back to exp.
MEM_SEARCH_FRESHNESS_DECAY=exp

# ---- Graph expansion -----------------------------------------------
# Max strongest edges diffused per node during neighbor expansion
# (prevents high-degree nodes from flooding the result).
EXPAND_MAX_EDGES_PER_NODE=20
# Weak-edge pruning threshold during expansion (0.0 disables).
EXPAND_MIN_EDGE_WEIGHT=0.0

# ---- Hybrid retrieval (RRF) -----------------------------------------
# Reciprocal Rank Fusion constant k for FTS5 + semantic fusion
# (both sides count even if only one hits).
RRF_K=60.0
# RRF weights per side: semantic / exact (FTS).
RRF_SEM_WEIGHT=1.0
RRF_FTS_WEIGHT=0.1
# FTS weight used when the query looks like an exact identifier (commit hash,
# "#123" PR/issue number, "ABC-123" ticket). Semantic search cannot match those
# tokens against prose, so the exact channel needs to outrank the semantic head;
# `w/(k+q) > 1/(k+top_k)` gives the ~0.94 floor. 1.0 sits exactly on that floor
# and, worse, ties with the semantic weight (both 1/60 at rank 0), leaving the
# winner to implementation order; 1.1 is where the offline metrics saturate
# (22 identifier queries: recall@5 0.356 -> 0.690, MRR@10 0.636 -> 1.000).
# 1.5 keeps headroom for store/embedding drift. Natural-language queries keep
# RRF_FTS_WEIGHT, so global ranking is unchanged.
RRF_FTS_EXACT_WEIGHT=1.5
# ---- TDB (TriviumDB) BM25 text channel: second CJK text recall path -----
# OFF by default: enabling adds an extra TQL read per hybrid query and a warmup
# step. Kept as an opt-in channel for A/B testing against FTS5 (trigram);
# see scripts/tdb_text_ab.py and core/tdb_text_index.py.
# 1 = enabled (extra RRF channel during retrieval); 0 = fully inert (no TDB
# calls, not even warmup, so default runtime behavior is bitwise unchanged).
TDB_TEXT_ENABLED=0
# RRF weight of the TDB text channel (compare: FTS 0.1 / exact 1.5 above).
TDB_TEXT_WEIGHT=1.0
# Candidate count for the TDB channel: 0 = reuse FTS's limit.
TDB_TEXT_LIMIT=0
# Skip the TDB text channel when FTS already returns this many hits or more
# (most queries then pay zero cost). 0 = never skip (always query TDB when enabled).
TDB_TEXT_FTS_FLOOR=3
# Graph expansion depth for the semantic ordering: 0 = pure semantic ranking
# (default); 1 = graph neighbors join the ordering (one-flag fallback).
RETRIEVAL_EXPAND_DEPTH=0

# ---- Memory tiering -------------------------------------------------
# Retrieval-side view that keeps log-ish nodes out of the default pool.
# Comma-separated type lists; unregistered types fall back to facts.
# tier="" (empty string) disables filtering (= pre-2.0 full-pool behavior).
TIER_FACTS=memory,correction,decision,plan,task,review,solution,inspiration,user_intent,character_state
TIER_LOGS=record,event,git_commit
DEFAULT_TIER=facts

# ---- Lifecycle session-end -------------------------------------------
# Legacy "session highlights" path switch (type=memory / facts tier).
# 1 (default) = unchanged behavior; 0 = session-end skips the highlights
# (skip_reason=session_memory_disabled) and writes only the session
# capsule (type=task kind=handoff) built from the session buffer.
SESSION_MEMORY_INGEST=1

# ---- Lifecycle post-turn: substantive-turn filter (session buffer) ----
# The session buffer only accumulates substantive turns (issue #170).
# A turn is substantive when ANY of: (1) it made tool calls (tool_calls_count
# > 0); (2) its <thought> body is at least this many chars (stripped) AND a
# conclusion field (outcome/conclusion/judgement/deliverable) is non-empty;
# (3) the user message contains an imperative verb. Non-substantive turns
# are skipped observably (skip_reason=non_substantive), never silently
# dropped; a session of only short turns produces no capsule at session-end.
# Below is the criterion-2 thought body length threshold (chars).
SESSION_BUFFER_MIN_THOUGHT_CHARS=400

# ---- Lifecycle: capsule crash recovery (orphan session buffers) -----
# A capsule is normally written at session-end. If the process is killed
# (planned shutdown / app crash) session-end never runs and the session
# buffer stays status=active forever. This scanner finalizes buffers that
# have been idle longer than AFTER_SECONDS: once at startup and every
# INTERVAL_SECONDS while the service runs.
# Master switch: 1 = background loop on (default); 0 = loop off (the
# manual endpoint POST /lifecycle/recover-orphan-capsules still works).
SESSION_CAPSULE_RECOVER_ENABLED=1
# Idle threshold (seconds). 30 minutes is deliberately conservative -- a
# live conversation's turn gap is far below it, and a false positive does
# NOT lose turns: session-end re-merges ALL buffers into the same capsule
# node (node_id stable), so the cost is one intermediate half-filled
# capsule, never a dropped turn.
SESSION_CAPSULE_RECOVER_AFTER_SECONDS=1800
# Background scan interval (seconds).
SESSION_CAPSULE_RECOVER_INTERVAL_SECONDS=300

# ---- Limits --------------------------------------------------------
# Max characters of a single memory content; longer writes are rejected.
MEM_INGEST_MAX_LENGTH=50000
# Max characters of a search query; longer queries are rejected at the
# retrieval entries (422) instead of hitting the embedding model's context limit.
MEM_SEARCH_MAX_QUERY_CHARS=8000

# ---- Write-guard policy --------------------------------------------
# Status of the write-entry guard (see core/policy.py).
#   warn (default) = only log warnings and surface them in the result,
#                    never change write behaviour.
#   enforce        = the policy actually blocks / skips.
POLICY_MODE=warn
# Comma-separated types that are protected from automatic overwrite
# (never marked `outdated` nor linked with a REVISED_BY edge under
# `enforce`).  A node with `payload.protected=True` is protected too.
POLICY_PROTECTED_TYPES=rule
# Per-type soft size limits, e.g. "task:20000,plan:80000".
# Defaults are derived from the observed content-length distribution so
# that normal writes pass while runaway growth (e.g. a whole document
# stored as one memory) is caught.  Under `warn` they only warn; under
# `enforce` they reject.
POLICY_TYPE_LIMITS=record:8000,memory:8000,task:10000,plan:12000,kb_chunk:8000,novel_chunk:12000
# Total character cap for core memory (facts tier); 0 = unlimited.
POLICY_MAX_CORE_TOTAL=0
# Human gate for policy config: runtime overrides are honoured only when
# this is 1.  Agent-side tools never expose a way to change the policy --
# it can only be changed via .env + restart.
PALIMPSEST_POLICY_UPDATE=

# ---- Conflict detection --------------------------------------------
# Comma-separated memory types exempt from conflict detection: listed types
# are never marked `outdated` nor linked with a REVISED_BY edge. Empty
# (default) keeps behaviour unchanged.
# Use it for accumulating records — e.g. tasks — that are not "the same
# fact superseded".  Example: CONFLICT_SKIP_TYPES=task
CONFLICT_SKIP_TYPES=
# Enable bi-temporal time-window conflict judgment.  When on, similar facts
# whose world-time windows do NOT overlap (e.g. "lived in Beijing 10y ago"
# vs "lives in Shanghai now") are not treated as superseding each other.
# Default off = behaviour unchanged (high-risk semantic change).
CONFLICT_TIME_WINDOW=
# Enable automatic similarity-based supersession.  Default OFF: a write never
# marks a merely-similar memory as `outdated` on similarity alone — similar
# candidates are reported as `related_ids` only, and supersession happens only
# when the caller explicitly declares it (mem_ingest `replaces`).  Turn ON to
# restore the legacy behaviour (similarity > 0.75 -> mark outdated).
# Rationale: "similar" is not "the same fact superseded"; a bare threshold
# swallows complementary notes on the same topic.
CONFLICT_AUTO_SUPERSEDE=

# ---- RP-dedicated instance (SillyTavern memory bridge) --------------
# Flip to 1 to turn this instance into an RP-only deployment. Two changes:
# 1) every endpoint that takes (or defaults) a `domain` is locked to
#    RP_DOMAIN -- omitted domain is auto-filled, any other domain -> 400;
# 2) ingest no longer links kb_chunk knowledge references (an RP-only
#    store has no kb_chunk; the lookup waste).
# Default off = behaviour completely unchanged.
RP_MODE=
# The locked domain name when RP_MODE is on (empty falls back to "rp").
RP_DOMAIN=rp

# ---- Pinned domain (issue #176) ----------------------------------
# A domain whose active nodes are injected on EVERY turn, unconditionally (no
# semantic-similarity gate) - for standing rules that must always apply even
# when they share no keywords with the current message.
# Nodes are sorted by importance desc inside a hard character budget and
# truncated only at node boundaries; overflow is reported as pin.truncated /
# pin.dropped in the pre-turn response instead of being silently dropped.
# Empty = off (behaviour completely unchanged).
PIN_DOMAIN=
# Character budget for the pinned block (default 3000, same order as MEMORY.md).
PIN_BUDGET_CHARS=3000

# ---- Knowledge base ----------------------------------------------
# Root directory of the knowledge base (Obsidian .md files) to index.
# Leave empty to fall back to the default project-relative location.
KNOWLEDGE_DIR=
