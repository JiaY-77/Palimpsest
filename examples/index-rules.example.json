{
  "kind_map": [
    {
      "kind": "reference",
      "dir_prefix": "reference"
    },
    {
      "kind": "overview",
      "filename": "00-总览.md"
    },
    {
      "kind": "archive",
      "glob": "archive/**/*"
    }
  ],
  "default_kind": "note",
  "chunk_strategy": "heading",
  "min_chunk_len": 300,
  "max_chunk_len": 800,
  "domain": "kb",
  "include": [
    "*.md"
  ],
  "exclude": [
    ".obsidian",
    "drafts"
  ],
  "require_frontmatter_id": false
}