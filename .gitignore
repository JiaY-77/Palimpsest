# 虚拟环境
venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 打包产物（pip install -e / build 生成）
*.egg-info/
build/
dist/

# 环境变量（包含你的 API 密钥）
.env
.env.bak*
.env.*.bak*

# IDE 配置
.vscode/
.idea/

# 评测数据（query set / 结果 / 临时副本，含本机私有记忆内容）
eval/.tmp/
eval/.tmp_fusion/
eval/*.json
!eval/fusion_set_manual.example.json
eval/report_*.md
eval/*_report_*.md


# TriviumDB 数据库文件（本地测试用）
*.db
*.vec
*.tdb

data/

# reindex 断点续跑状态（运行时生成，不入库；实际路径为 <库目录>/reindex_state_<库文件名>.json）
data/reindex_state.json
data/reindex_state.json.tmp
data/reindex_state_*.json
data/reindex_state_*.json.tmp

# 个人本地测试数据（不公开；按模式忽略，不写具体文件名）
*- 20??-??-??@*.json

# 内部执行卡（不公开，仅本地工作用）
TASK_palimpsest_*.md

# 脚本备份（git 历史已有完整旧版，不重复入库）
*.bak_v*

# 本机知识库图谱数据（不入库，开源只保留示例）
scripts/graph_edges.json

# 本地服务日志
scripts/start_rest.log
scripts/manual_restart.log
scripts/manual_restart.log.err

# 压测日志（含绝对路径，不入库）
scripts/tdb_stress/err.log

# 小说语料本地数据（本地创作数据不入公网；入库/建边脚本本身入仓库）
_novel_input/
_novel_relations.json
# 内部任务书（带内部编号/执行卡，只在本地保留）
_task_*.md

# 一次性探索脚本（文件名含内部任务编号，只在本地保留；
# 有复用价值的脚本会去掉编号、中性化后再入库，参考 scripts/ab_snapshot_*.py）
scripts/_t[0-9]*.py
scripts/tdb_stress/_*.py

# 本地临时探针/工作区（含个人数据的定位工具、一次性验证脚本，不入库）
tmp/

# 压测工作区的临时产物
scripts/tdb_stress/results/
scripts/tdb_stress/patches/
scripts/tdb_stress/smoke_086/
scripts/tdb_stress/issue_draft_*.md

# 工具缓存与覆盖率产物（本地生成，不入库）
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local embedding model cache (auto-downloaded GGUF, ~610 MB) and partial downloads.
# Never commit these: GitHub rejects files over 100 MB, and the file is reproducible.
models/
*.gguf
*.gguf.part
