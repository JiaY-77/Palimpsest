# 虚拟环境
venv/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 打包产物（pip install -e / build 生成）
*.egg-info/
build/
dist/

# 环境变量（包含你的 API 密钥）
.env

# IDE 配置
.vscode/
.idea/

# 评测数据（query set / 结果 / 临时副本，含本机私有记忆内容）
