eval/*.json
eval/report_*.md


# TriviumDB 数据库文件（本地测试用）
*.db
*.vec
*.tdb

data/

# reindex 断点续跑状态（运行时生成，不入库；实际路径为 <库目录>/reindex_state_<库文件名>.json）
data/reindex_state.json
data/reindex_state.json.tmp
data/reindex_state_*.json
data/reindex_state_*.json.tmp

# 个人本地测试数据（不公开）
泷泽由佳 - 2026-04-25@17h40m44s.json

# 内部执行卡（不公开，仅本地工作用）
TASK_palimpsest_*.md

# 脚本备份（git 历史已有完整旧版，不重复入库）
*.bak_v*

# 本机知识库图谱数据（不入库，开源只保留示例）
scripts/graph_edges.json

# 本地服务日志
scripts/start_rest.log

# 压测日志（含绝对路径，不入库）
scripts/tdb_stress/err.log

# 小说语料本地数据（本地创作数据不入公网；入库/建边脚本本身入仓库）
_novel_input/
_novel_relations.json
_task_novel_index.md
_task_novel_links.md

# 一次性探索脚本（文件名含内部任务编号，只在本地保留；
# 有复用价值的脚本会去掉编号、中性化后再入库，参考 scripts/ab_snapshot_*.py）
scripts/_t[0-9]*.py
scripts/tdb_stress/_*.py

# 压测工作区的临时产物
scripts/tdb_stress/results/
scripts/tdb_stress/patches/
